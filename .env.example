# Telegram: the token from @BotFather (never commit a real one)
BOT_TOKEN=replace_with_your_bot_token

# Shared secret between the bot and the API (the API trusts the tg_id it is given, so it must not be open).
# Generate one with: openssl rand -hex 32   (empty = no check, local development only)
API_TOKEN=
# Comma-separated Telegram user ids that may use the bot (empty = everybody)
ALLOWED_TG_IDS=
# Sources of one user that may be processed at the same time
MAX_ACTIVE_SOURCES=3

# Translation: ollama | argos
TRANSLATOR=ollama
# Ollama runs on the host; docker-compose overrides the URL with host.docker.internal.
# Pull the model once on the host: ollama pull <OLLAMA_MODEL>
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
TARGET_LANG=ru
TARGET_LANG_NAME=Russian

# Learning rules
CORRECT_TO_LEARN=4
# false: 4 correct answers in total; true: 4 in a row (a mistake resets the counter)
RESET_ON_WRONG=false
# how many last asked words are excluded from the next question
RECENT_WINDOW=10
MAX_WORDS_PER_SOURCE=300

# Limits for user-supplied sources
MAX_PDF_MB=20
MAX_PAGE_MB=5
# Set to true only in local development to allow links to private/loopback addresses (disables SSRF protection)
ALLOW_PRIVATE_URLS=false

# Production only (docker-compose.prod.yml): the Postgres password, hex so it is safe inside DATABASE_URL.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
